# Firecrawl API key (required) - https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# OpenAI-compatible API key (required) - used with OpenRouter or any compatible provider
OPENAI_API_KEY=

# Base URL for the LLM provider
BASE_URL=https://openrouter.ai/api/v1

# Model to use for generation
OPENAI_MODEL=openai/gpt-oss-20b:free

# Directory to store scraped content
TEMP_DIR=./uploads

# Text splitting settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Qdrant collection name
COLLECTION_NAME=url_to_rag

# Enable hybrid RAG (dense + sparse embeddings)
USE_HYBRID_RAG=True

# Number of chunks to retrieve per query
RETRIEVAL_K=5
